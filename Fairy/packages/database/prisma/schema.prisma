generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mood {
  HEALING    @map("治愈")
  PASSIONATE @map("热血")
  SUSPENSE   @map("悬疑")
  MELANCHOLY @map("致郁")
  RELAXED    @map("轻松")
  ROMANTIC   @map("浪漫")
}

enum Scene {
  RAINY_DAY           @map("雨天")
  INSOMNIA            @map("失眠夜")
  WEEKEND_AFTERNOON   @map("周末午后")
  HOME_ALONE          @map("独自在家")
  DATE_NIGHT          @map("约会夜")
  COMMUTE             @map("通勤路上")
}

enum RentalStatus {
  ACTIVE
  RETURNED
}

enum BehaviorAction {
  RECOMMEND
  BORROW_SUCCESS
  BORROW_OUT_OF_STOCK
  RETURN_SUCCESS
  TRIP_PLANNED
}

enum TripStatus {
  DRAFT
}

// FU-14：记忆中心——对话中值得记住的要点（偏好/事实/意图）
enum MemoryKind {
  PREFERENCE
  FACT
  INTENT
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  role         String         @default("user")
  passwordHash String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  profile      Profile?
  rentals      Rental[]
  behaviorLogs BehaviorLog[]
  sessions     Session[]
  trips        Trip[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// FU-10：refresh token 只存 sha256 哈希，明文仅在签发时返回一次
model RefreshToken {
  id                String        @id @default(uuid())
  tokenHash         String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Movie {
  id          String   @id @default(uuid())
  title       String   @unique
  director    String
  year        Int
  moods       Mood[]
  scenes      Scene[]
  genres      String[]
  quote       String?
  stock       Int      @default(0)
  totalStock  Int      @default(0)
  coverUrl    String?
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rentals     Rental[]

  @@map("movies")
}

model Profile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  avatarUrl       String?
  styleTags       String[]
  likeGenres      String[]
  avoidFood       String[]
  dietPreference  String?
  travelStyle     String?
  memories        Memory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model Rental {
  id        String       @id @default(uuid())
  userId    String
  movieId   String
  status    RentalStatus @default(ACTIVE)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie        @relation(fields: [movieId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, movieId, status])
  @@map("rentals")
}

model BehaviorLog {
  id        String         @id @default(uuid())
  userId    String
  action    BehaviorAction
  movieId   String?
  rentalId  String?
  payload   Json?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("behavior_logs")
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  title     String        @default("")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@map("sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      ChatRole
  content   String
  payload   Json?
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// FU-13：旅行规划——行程落库（含校验后的 POI 与路线），为二期回放/历史列表打底
model Trip {
  id          String     @id @default(uuid())
  userId      String
  destination String
  days        Int
  itinerary   Json
  route       Json?
  status      TripStatus @default(DRAFT)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, createdAt])
  @@map("trips")
}

// FU-14：记忆中心——结构化记忆（偏好/事实/意图），关联 profileId（必填），可选 sessionId
model Memory {
  id        String     @id @default(uuid())
  profileId String
  sessionId String?
  kind      MemoryKind
  content   String
  metadata  Json?
  createdAt DateTime   @default(now())
  profile   Profile    @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@index([profileId, kind])
  @@index([profileId, createdAt])
  @@map("memories")
}
