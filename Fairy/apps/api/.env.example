# Server
PORT=3000
# Reverse-proxy hops in front of the API (default: 1). Rate limiters key on the
# client IP, so this must match the deployment: 0 only when directly exposed.
TRUST_PROXY_HOPS=

# Database
# Neon: pooled URLs should include connect_timeout=15&pool_timeout=15 so Prisma
# survives compute wake (default 5s timeout looks like "CRUD is broken").
DATABASE_URL=postgresql://user:password@localhost:5432/fairy

# AI providers
# Chat uses @fairy/ai-sdk. Without any key the agent falls back to the
# Phase 2 rule/template replies (graceful degradation).
# AI_PROVIDER: deepseek | openai | claude (default: deepseek)
AI_PROVIDER=
AI_MODEL=
# Optional provider endpoint overrides (default to the vendor endpoints)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=
# Optional per-request timeout in ms (default: 20000)
AI_TIMEOUT_MS=

# Embedding (FU-16, optional): memory vector recall, independent of the chat
# provider. Unset -> embeddings disabled, memory retrieval stays structured.
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY when empty.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional custom endpoint (falls back to OPENAI_BASE_URL, then OpenAI default)
EMBEDDING_BASE_URL=

# Amap server API key
AMAP_SERVER_KEY=your_amap_server_key_here

# JWT (required — the API refuses to start without it)
JWT_SECRET=your_jwt_secret_here
