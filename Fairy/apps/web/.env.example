# Amap JS API browser security key (frontend only).
# 必须为高德控制台创建的「Web端(JS API)」安全密钥并配置 referrer 防盗链白名单；
# build-time 内联，严禁把服务端 AMAP_SERVER_KEY 填在这里。
# 未配置（或加载失败）时前端行程地图静默不渲染，不影响其余功能。
VITE_AMAP_JS_KEY=your_amap_js_key_here

# API base URL (optional — defaults to same origin via Vite proxy)
VITE_API_URL=
